# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real secrets and is git-ignored. Never commit it, paste it in chat, or put it in a screenshot.
# Quick way to generate one with random secrets:   bash deploy/make-env.sh 8046

# Host port for the website = 8000 + the last two digits of YOUR student ID.
#   Alaa Aladdin (202300746) -> 8046        Reem Tamer (202300845) -> 8045
APP_PORT=8080

# PostgreSQL (used by both the db and backend containers)
POSTGRES_DB=lostfound
POSTGRES_USER=lostfound_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Signs the session cookie. At least 32 random characters:   openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth "Web application" client (Google Cloud Console > APIs & Services > Credentials).
# Leave the three blank to run without sign-in (browsing still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud Console exactly (same port!)
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Comma-separated email domains allowed to sign in. Empty = any verified Google account.
ALLOWED_EMAIL_DOMAINS=zewailcity.edu.eg

# true only when the site is served over HTTPS (Secure cookies). Keep false for http://localhost.
COOKIE_SECURE=false
